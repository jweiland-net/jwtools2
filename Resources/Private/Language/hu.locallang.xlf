    <header/>
    <body>
      <trans-unit id="indexqueueworker_title" xml:space="preserve">
        <source>Index Queue Worker</source>
      <target state="translated">Indexsor-feldolgozó</target></trans-unit>
      <trans-unit id="indexqueueworker_description" xml:space="preserve">
        <source>Processes the items in the Index Queue and sends them to Solr.</source>
      <target state="translated">Feldolgozza az Index Queue elemeit, és elküldi őket a Solrnak.</target></trans-unit>
      <trans-unit id="indexqueueworker_field_documentsToIndexLimit" xml:space="preserve">
        <source>Number of documents to index</source>
      <target state="translated">Az indexelendő dokumentumok száma</target></trans-unit>
      <trans-unit id="indexqueueworker_field_maxSitesPerRun" xml:space="preserve">
        <source>Max sites per run</source>
      <target state="translated">Webhelyek maximális száma futásonként</target></trans-unit>
      <trans-unit id="executeQueryTask.title" xml:space="preserve">
        <source>Execute SQL Query</source>
      <target state="translated">SQL-lekérdezés végrehajtása</target></trans-unit>
      <trans-unit id="executeQueryTask.description" xml:space="preserve">
        <source>With this task you can write your own SQL-Statement which will be executed with each scheduler run</source>
      <target state="translated">Ezzel a feladattal saját SQL-utasítást írhat, amely minden ütemezőfuttatáskor végrehajtódik.</target></trans-unit>
      <trans-unit id="executeQueryTask.field.sqlQuery" xml:space="preserve">
        <source>SQL Query</source>
      <target state="translated">SQL-lekérdezés</target></trans-unit>
      <trans-unit id="mod.solr.solrFeaturesOverview" xml:space="preserve">
        <source>Module: Solr Overview</source>
      <target state="translated">Modul: Solr áttekintés</target></trans-unit>
      <trans-unit id="mod.solr.memoryUsageSchedulerTask" xml:space="preserve">
        <source>Current Memory Usage of running jwtools2 Solr Scheduler Task</source>
      <target state="translated">A futó jwtools2 Solr ütemező feladat aktuális memóriahasználata</target></trans-unit>
      <trans-unit id="mod.solr.configuredRootPages" xml:space="preserve">
        <source>Root Pages with Solr configuration</source>
      <target state="translated">Solr-konfigurációval rendelkező gyökér oldalak</target></trans-unit>
